{
  "framework": "nextjs",
  "buildCommand": "next build",
  "devCommand": "next dev",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/backfill-orders",
      "schedule": "30 0 * * *"
    },
    {
      "path": "/api/cron/repair-orders?historical=true&providers=grab",
      "schedule": "0 2 * * *"
    }
  ]
}
