{
  "framework": "nextjs",
  "buildCommand": "next build",
  "devCommand": "next dev",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/sync-orders",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/refresh-sessions",
      "schedule": "0 6 * * *"
    }
  ]
}
