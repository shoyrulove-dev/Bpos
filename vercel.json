{
  "framework": "nextjs",
  "buildCommand": "next build",
  "devCommand": "next dev",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/backfill-orders",
      "schedule": "30 0 * * *"
    },
    {
      "path": "/api/cron/repair-orders?staleHours=3&staleMax=10&historical=false&providers=be,grab",
      "schedule": "0 */3 * * *"
    }
  ]
}
